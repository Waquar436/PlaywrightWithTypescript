# copy this file to `.env` (which is git-ignored) and edit as needed
# The config reads this at load time, so switching environment is ONE change

# macOS/Linux: cp .env.example .env
# windows:     copy .env.example .env

# Then set ENV before the test command:
# PowerShell: $env:ENV="staging"; npm test
# CMD:        set ENV=staging && npm test
# bash:       ENV=staging npm test

ENV=prod
# BASE_URL is resolved inside the config from ENV; real projects would put the 
# actual host(s) and any secrets here, never in source control.